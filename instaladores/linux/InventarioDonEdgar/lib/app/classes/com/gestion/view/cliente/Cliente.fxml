<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.cliente.ClienteControlador"
      spacing="14"
      styleClass="modulo-contenido"
      stylesheets="@../css/estilos.css">

    <padding>
        <Insets top="22"
                right="25"
                bottom="22"
                left="25"/>
    </padding>

    <!-- ENCABEZADO -->

    <HBox alignment="CENTER_LEFT"
          spacing="15">

        <VBox spacing="3">

            <Label text="Clientes"
                   styleClass="titulo-pagina"/>

            <Label text="Administre la información de los clientes y consulte sus saldos pendientes."
                   styleClass="subtitulo-pagina"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="+ Nuevo cliente"
                mnemonicParsing="false"
                onAction="#abrirFormularioAgregar"
                styleClass="boton-principal"/>

    </HBox>

    <!-- BÚSQUEDA -->

    <VBox spacing="10"
          styleClass="tarjeta-filtros">

        <padding>
            <Insets top="14"
                    right="16"
                    bottom="14"
                    left="16"/>
        </padding>

        <VBox spacing="2">

            <Label text="Buscar cliente"
                   styleClass="filtro-titulo"/>

            <Label text="Localice rápidamente un cliente utilizando sus datos principales."
                   styleClass="filtro-descripcion"/>

        </VBox>

        <VBox spacing="4">

            <Label text="Nombre, identificación, teléfono o correo"
                   styleClass="campo-label"/>

            <TextField fx:id="txtBuscar"
                       promptText="Escriba para buscar..."
                       prefHeight="36"
                       maxWidth="600"/>

        </VBox>

    </VBox>

    <!-- TABLA -->

    <VBox spacing="12"
          VBox.vgrow="ALWAYS"
          styleClass="tarjeta-tabla">

        <padding>
            <Insets top="15"
                    right="15"
                    bottom="15"
                    left="15"/>
        </padding>

        <HBox alignment="CENTER_LEFT">

            <VBox spacing="2">

                <Label text="Listado de clientes"
                       styleClass="tabla-titulo"/>

                <Label text="Consulte los datos registrados, saldos pendientes y acciones disponibles."
                       styleClass="tabla-descripcion"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Clientes"
                   styleClass="etiqueta-estado"/>

        </HBox>

        <TableView fx:id="tablaClientes"
                   VBox.vgrow="ALWAYS">

            <placeholder>

                <VBox alignment="CENTER"
                      spacing="5">

                    <Label text="No hay clientes registrados"
                           styleClass="tabla-vacia-titulo"/>

                    <Label text="Registre un cliente para comenzar a gestionar sus saldos."
                           styleClass="tabla-vacia-texto"/>

                </VBox>

            </placeholder>

            <columns>

                <TableColumn fx:id="columnaIdentificacion"
                             text="Identificación"
                             prefWidth="120"/>

                <TableColumn fx:id="columnaNombre"
                             text="Nombre"
                             prefWidth="170"/>

                <TableColumn fx:id="columnaTelefono"
                             text="Teléfono"
                             prefWidth="120"/>

                <TableColumn fx:id="columnaCorreo"
                             text="Correo electrónico"
                             prefWidth="200"/>

                <TableColumn fx:id="columnaSaldo"
                             text="Saldo pendiente"
                             prefWidth="125"/>

                <TableColumn fx:id="columnaEditar"
                             text="Acciones"
                             prefWidth="190"
                             minWidth="190"
                             sortable="false"/>

            </columns>

        </TableView>

    </VBox>

</VBox>
