<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controller.MenuLateralControlador"
            fx:id="panelBordes"
            prefWidth="1200"
            prefHeight="720"
            stylesheets="@css/estilos.css">

    <!-- ===================================================== -->
    <!-- MENÚ LATERAL                                          -->
    <!-- ===================================================== -->

    <left>

        <VBox prefWidth="270"
              minWidth="270"
              maxWidth="270"
              styleClass="menu-lateral">

            <!-- PARTE SUPERIOR FIJA -->

            <VBox alignment="CENTER"
                  spacing="4">

                <padding>
                    <Insets top="14"
                            right="18"
                            bottom="10"
                            left="18"/>
                </padding>

                <ImageView fitWidth="80"
                           fitHeight="80"
                           preserveRatio="true"
                           smooth="true"
                           mouseTransparent="true">

                    <image>
                        <Image url="@images/logo-don-edgar.png"/>
                    </image>

                </ImageView>

                <Label text="Don Edgar"
                       styleClass="titulo-menu"/>

                <Label text="Inventario y ventas"
                       styleClass="subtitulo-menu"/>

            </VBox>

            <!-- NAVEGACIÓN DESPLAZABLE -->

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        styleClass="menu-scroll">

                <content>

                    <VBox spacing="5">

                        <padding>
                            <Insets top="8"
                                    right="18"
                                    bottom="12"
                                    left="18"/>
                        </padding>

                        <Label text="NAVEGACIÓN"
                               styleClass="etiqueta-menu"/>

                        <Button text="⌂   Inicio"
                                onAction="#abrirInicio"
                                maxWidth="Infinity"
                                prefHeight="40"
                                alignment="CENTER_LEFT"
                                styleClass="boton-menu"/>

                        <Button text="▣   Productos"
                                onAction="#abrirProductos"
                                maxWidth="Infinity"
                                prefHeight="40"
                                alignment="CENTER_LEFT"
                                styleClass="boton-menu"/>

                        <Button text="▤   Inventario / Lotes"
                                onAction="#abrirLotes"
                                maxWidth="Infinity"
                                prefHeight="40"
                                alignment="CENTER_LEFT"
                                styleClass="boton-menu"/>

                        <Button text="♙   Clientes"
                                onAction="#abrirClientes"
                                maxWidth="Infinity"
                                prefHeight="40"
                                alignment="CENTER_LEFT"
                                styleClass="boton-menu"/>

                        <Button text="Ventas"
                                onAction="#abrirVentas"
                                maxWidth="Infinity"
                                prefHeight="40"
                                alignment="CENTER_LEFT"
                                styleClass="boton-menu"/>

                        <Button text="▥   Reportes"
                                onAction="#abrirReportes"
                                maxWidth="Infinity"
                                prefHeight="40"
                                alignment="CENTER_LEFT"
                                styleClass="boton-menu"/>

                        <Region prefHeight="8"/>

                        <Label text="SISTEMA"
                               styleClass="etiqueta-menu"/>

                        <Button text="⚙   Cambiar credenciales"
                                onAction="#abrirConfiguracionUsuario"
                                maxWidth="Infinity"
                                prefHeight="40"
                                alignment="CENTER_LEFT"
                                styleClass="boton-menu"/>

                    </VBox>

                </content>

            </ScrollPane>

            <!-- PARTE INFERIOR SIEMPRE VISIBLE -->

            <VBox spacing="7">

                <padding>
                    <Insets top="8"
                            right="18"
                            bottom="14"
                            left="18"/>
                </padding>

                <VBox spacing="2"
                      styleClass="menu-usuario">

                    <Label text="Administrador"
                           styleClass="menu-usuario-nombre"/>

                    <Label text="● Sesión activa"
                           styleClass="menu-usuario-estado"/>

                </VBox>

                <Button text="↪   Cerrar sesión"
                        onAction="#cerrarSesion"
                        maxWidth="Infinity"
                        prefHeight="40"
                        alignment="CENTER_LEFT"
                        styleClass="boton-salir"/>

            </VBox>

        </VBox>

    </left>

    <!-- ===================================================== -->
    <!-- BARRA SUPERIOR                                        -->
    <!-- ===================================================== -->

    <top>

        <HBox alignment="CENTER_LEFT"
              prefHeight="68"
              minHeight="68"
              spacing="15"
              styleClass="barra-superior">

            <padding>
                <Insets top="9"
                        right="28"
                        bottom="9"
                        left="28"/>
            </padding>

            <VBox spacing="2">

                <Label text="Panel principal"
                       styleClass="titulo-superior"/>

                <Label text="Víveres y Cárnicos Don Edgar"
                       styleClass="subtitulo-superior"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT"
                  spacing="2">

                <Label text="Administrador"
                       styleClass="usuario-superior"/>

                <Label text="Sistema local"
                       styleClass="sesion-superior"/>

            </VBox>

        </HBox>

    </top>

</BorderPane>