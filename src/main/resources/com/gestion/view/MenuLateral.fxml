<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="panelBordes"
            prefHeight="720.0"
            prefWidth="1200.0"
            stylesheets="@css/estilos.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controller.MenuLateralControlador">

    <left>
        <VBox prefWidth="230.0"
              spacing="8.0"
              styleClass="menu-lateral">

            <padding>
                <Insets top="25" right="15" bottom="20" left="15"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <ImageView fitHeight="48"
                           fitWidth="48"
                           preserveRatio="true">
                    <image>
                        <Image url="@../../../images/lpg_logo.png"/>
                    </image>
                </ImageView>

                <VBox spacing="2">
                    <Label text="Don Edgar"
                           styleClass="titulo-logo"/>

                    <Label text="Gestión de inventario"
                           styleClass="subtitulo-logo"/>
                </VBox>
            </HBox>

            <Separator styleClass="separador-menu">
                <VBox.margin>
                    <Insets top="15" bottom="15"/>
                </VBox.margin>
            </Separator>

            <Label text="MENÚ"
                   styleClass="titulo-seccion-menu"/>

            <Button text="Inicio"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>

            <Button fx:id="productos"
                    text="Productos"
                    onAction="#abrirProductos"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>

            <Button fx:id="lotes"
                    text="Inventario / Lotes"
                    onAction="#abrirLotes"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>

            <Button text="Clientes"
                    onAction="#abrirClientes"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>

            <Button text="Ventas"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>

            <Button text="Reportes"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator styleClass="separador-menu"/>

            <Button text="Cerrar sesión"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-salir"/>

        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="70"
              spacing="10"
              styleClass="barra-superior">

            <padding>
                <Insets left="30" right="30"/>
            </padding>

            <VBox>
                <Label text="Sistema de gestión"
                       styleClass="titulo-superior"/>

                <Label text="Víveres y Cárnicos Don Edgar"
                       styleClass="subtitulo-superior"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT">
                <Label text="Administrador"
                       styleClass="usuario-nombre"/>

                <Label text="Sesión activa"
                       styleClass="usuario-estado"/>
            </VBox>

        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER"
              spacing="12"
              styleClass="contenido-principal">

            <Label text="Bienvenido"
                   styleClass="bienvenida-titulo"/>

            <Label text="Selecciona una opción del menú para comenzar."
                   styleClass="bienvenida-texto"/>

        </VBox>
    </center>

</BorderPane>