<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controller.MenuLateralControlador"
            fx:id="panelBordes"
            stylesheets="@css/estilos.css">


    <!-- ============================= -->
    <!-- MENÚ LATERAL -->
    <!-- ============================= -->

    <left>

        <VBox prefWidth="300"
              spacing="10"
              styleClass="menu-lateral">

            <padding>
                <Insets top="30"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>


            <!-- NOMBRE DEL SISTEMA -->

            <Label text="Don Edgar"
                   styleClass="titulo-menu"/>

            <Label text="Gestión de inventario"
                   styleClass="subtitulo-menu"/>


            <Region prefHeight="20"/>


            <Label text="MENÚ"
                   styleClass="etiqueta-menu"/>


            <Region prefHeight="5"/>


            <!-- INICIO -->

            <Button text="Inicio"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>


            <!-- PRODUCTOS -->

            <Button text="Productos"
                    onAction="#abrirProductos"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>


            <!-- INVENTARIO -->

            <Button text="Inventario / Lotes"
                    onAction="#abrirLotes"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>


            <!-- CLIENTES -->

            <Button text="Clientes"
                    onAction="#abrirClientes"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>


            <!-- VENTAS -->

            <Button text="Ventas"
                    onAction="#abrirVentas"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>


            <!-- REPORTES -->

            <Button text="Reportes"
                    onAction="#abrirReportes"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>

            <!-- CONFIGURACIÓN -->

            <Button text="Cambiar credenciales"
                    onAction="#abrirConfiguracionUsuario"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>    


            <!-- ESPACIO -->

            <Region VBox.vgrow="ALWAYS"/>


            <!-- CERRAR SESIÓN -->

            <Button text="Cerrar sesión"
                    onAction="#cerrarSesion"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    styleClass="boton-menu"/>

        </VBox>

    </left>


    <!-- ============================= -->
    <!-- BARRA SUPERIOR -->
    <!-- ============================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              prefHeight="60"
              spacing="15"
              styleClass="barra-superior">

            <padding>
                <Insets top="10"
                        right="30"
                        bottom="10"
                        left="30"/>
            </padding>


            <VBox spacing="2">

                <Label text="Víveres y Cárnicos Don Edgar"
                       styleClass="titulo-superior"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox alignment="CENTER_RIGHT"
                  spacing="2">

                <Label text="Administrador"
                       styleClass="usuario-superior"/>

                <Label text="Sesión activa"
                       styleClass="sesion-superior"/>

            </VBox>

        </HBox>

    </top>


    <!-- ============================= -->
    <!-- CONTENIDO INICIAL -->
    <!-- ============================= -->

    <center>

        <VBox alignment="CENTER"
              spacing="15">

            <Label text="Víveres y Cárnicos Don Edgar"
                   styleClass="titulo-principal"/>

            <Label text="Sistema de gestión de inventario y ventas"
                   styleClass="subtitulo-principal"/>

        </VBox>

    </center>

</BorderPane>