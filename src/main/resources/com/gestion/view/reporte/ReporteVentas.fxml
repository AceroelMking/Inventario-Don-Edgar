<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.reporte.ReporteVentasControlador"
      spacing="15">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>


    <HBox alignment="CENTER_LEFT"
          spacing="10">

        <VBox spacing="5">

            <Label text="Reporte de ventas"/>

            <Label text="Consulta y exportación de ventas registradas"/>

        </VBox>


        <Region HBox.hgrow="ALWAYS"/>


        <Button text="Actualizar"
                onAction="#actualizar"/>

        <Button text="Exportar PDF"
                onAction="#exportarPdf"/>

    </HBox>


    <HBox alignment="CENTER_LEFT"
          spacing="10">

        <Label text="Desde"/>

        <DatePicker fx:id="fechaDesde"/>


        <Label text="Hasta"/>

        <DatePicker fx:id="fechaHasta"/>


        <Label text="Método de pago"/>

        <ComboBox fx:id="cmbMetodoPago"
                  prefWidth="150"/>


        <Button text="Limpiar"
                onAction="#limpiarFiltros"/>

    </HBox>


    <TableView fx:id="tablaVentas"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="columnaId"
                         text="ID"
                         prefWidth="60"/>


            <TableColumn fx:id="columnaFecha"
                         text="Fecha"
                         prefWidth="160"/>


            <TableColumn fx:id="columnaCliente"
                         text="Cliente"
                         prefWidth="180"/>


            <TableColumn fx:id="columnaMetodo"
                         text="Método"
                         prefWidth="130"/>


            <TableColumn fx:id="columnaTotal"
                         text="Total"
                         prefWidth="130"/>


            <TableColumn fx:id="columnaPagado"
                         text="Pagado"
                         prefWidth="130"/>


            <TableColumn fx:id="columnaPendiente"
                         text="Pendiente"
                         prefWidth="130"/>

        </columns>


        <placeholder>

            <Label text="No hay ventas registradas"/>

        </placeholder>

    </TableView>


    <HBox alignment="CENTER_LEFT"
          spacing="30">

        <VBox spacing="5">

            <Label text="Cantidad de ventas"/>

            <Label fx:id="lblCantidadVentas"
                   text="0"/>

        </VBox>


        <VBox spacing="5">

            <Label text="Total vendido"/>

            <Label fx:id="lblTotalVendido"
                   text="0"/>

        </VBox>


        <VBox spacing="5">

            <Label text="Total pagado"/>

            <Label fx:id="lblTotalPagado"
                   text="0"/>

        </VBox>


        <VBox spacing="5">

            <Label text="Saldo pendiente"/>

            <Label fx:id="lblTotalPendiente"
                   text="0"/>

        </VBox>

    </HBox>

</VBox>