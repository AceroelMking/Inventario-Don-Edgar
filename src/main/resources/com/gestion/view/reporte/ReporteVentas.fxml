<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controller.reporte.ReporteVentasControlador"
            stylesheets="@../css/estilos.css"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            pannable="true"
            styleClass="formulario-scroll">

    <content>

        <VBox styleClass="modulo-contenido"
              spacing="10"
              fillWidth="true">

            <padding>
                <Insets top="14"
                        right="18"
                        bottom="20"
                        left="18"/>
            </padding>


            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <HBox alignment="CENTER_LEFT"
                  spacing="10">

                <VBox spacing="1">

                    <Label text="Reportes"
                           styleClass="titulo-pagina"/>

                    <Label text="Consulta y analiza la información registrada en el sistema."
                           styleClass="subtitulo-pagina"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Actualizar"
                        onAction="#actualizar"
                        styleClass="boton-secundario"/>

                <Button text="Exportar PDF"
                        onAction="#exportarPdf"
                        styleClass="boton-primario"/>

            </HBox>


            <!-- ================================================= -->
            <!-- NAVEGACIÓN                                        -->
            <!-- ================================================= -->

            <HBox alignment="CENTER_LEFT"
                  spacing="8"
                  styleClass="tarjeta-filtros">

                <Button text="Ventas"
                        disable="true"
                        styleClass="boton-primario"/>

                <Button text="Inventario"
                        onAction="#abrirInventario"
                        styleClass="boton-secundario"/>

                <Button text="Cuentas por cobrar"
                        onAction="#abrirCuentasCobrar"
                        styleClass="boton-secundario"/>

            </HBox>


            <!-- ================================================= -->
            <!-- FILTROS                                           -->
            <!-- ================================================= -->

            <VBox spacing="6"
                  styleClass="tarjeta-filtros">

                <Label text="Filtros"
                       styleClass="filtro-titulo"/>

                <HBox alignment="BOTTOM_LEFT"
                      spacing="12">

                    <VBox spacing="2"
                          HBox.hgrow="ALWAYS">

                        <Label text="Desde"
                               styleClass="campo-label"/>

                        <DatePicker fx:id="fechaDesde"
                                    maxWidth="Infinity"/>

                    </VBox>


                    <VBox spacing="2"
                          HBox.hgrow="ALWAYS">

                        <Label text="Hasta"
                               styleClass="campo-label"/>

                        <DatePicker fx:id="fechaHasta"
                                    maxWidth="Infinity"/>

                    </VBox>


                    <VBox spacing="2"
                          HBox.hgrow="ALWAYS">

                        <Label text="Método de pago"
                               styleClass="campo-label"/>

                        <ComboBox fx:id="cmbMetodoPago"
                                  promptText="Todos"
                                  maxWidth="Infinity"/>

                    </VBox>


                    <Button text="Limpiar"
                            onAction="#limpiarFiltros"
                            styleClass="boton-secundario"/>

                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- TABLA                                             -->
            <!-- ================================================= -->

            <VBox spacing="5"
                  styleClass="tarjeta-tabla">

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="1">

                        <Label text="Ventas registradas"
                               styleClass="tabla-titulo"/>

                        <Label text="Resultados según los filtros seleccionados."
                               styleClass="tabla-descripcion"/>

                    </VBox>

                </HBox>


                <TableView fx:id="tablaVentas"
                           minHeight="275"
                           prefHeight="320"
                           maxHeight="320">

                    <columns>

                        <TableColumn fx:id="columnaId"
                                     text="ID"
                                     prefWidth="55"/>

                        <TableColumn fx:id="columnaFecha"
                                     text="Fecha"
                                     prefWidth="170"/>

                        <TableColumn fx:id="columnaCliente"
                                     text="Cliente"
                                     prefWidth="220"/>

                        <TableColumn fx:id="columnaMetodo"
                                     text="Método"
                                     prefWidth="135"/>

                        <TableColumn fx:id="columnaTotal"
                                     text="Total"
                                     prefWidth="145"/>

                        <TableColumn fx:id="columnaPagado"
                                     text="Pagado"
                                     prefWidth="160"/>

                        <TableColumn fx:id="columnaPendiente"
                                     text="Crédito"
                                     prefWidth="155"/>

                    </columns>


                    <placeholder>

                        <VBox alignment="CENTER"
                              spacing="4">

                            <Label text="No hay ventas para mostrar"
                                   styleClass="tabla-vacia-titulo"/>

                            <Label text="Modifica los filtros para consultar otros resultados."
                                   styleClass="tabla-vacia-texto"/>

                        </VBox>

                    </placeholder>

                </TableView>

            </VBox>


            <!-- ================================================= -->
            <!-- RESUMEN GENERAL                                   -->
            <!-- ================================================= -->

            <VBox spacing="12"
              styleClass="tarjeta-filtros resumen-reporte">

              <padding>
                     <Insets top="16"
                            right="22"
                            bottom="16"
                            left="22"/>
              </padding>

                <!-- TÍTULO -->

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="1">

                        <Label text="Resumen"
                               styleClass="tabla-titulo"/>

                        <Label text="Información consolidada de las ventas mostradas."
                               styleClass="tabla-descripcion"/>

                    </VBox>

                </HBox>


                <!-- ================================================= -->
                <!-- RESUMEN DE VENTAS                                 -->
                <!-- ================================================= -->

                <GridPane hgap="30"
                          vgap="2">

                    <columnConstraints>

                        <ColumnConstraints percentWidth="33.33"
                                           hgrow="ALWAYS"/>

                        <ColumnConstraints percentWidth="33.33"
                                           hgrow="ALWAYS"/>

                        <ColumnConstraints percentWidth="33.34"
                                           hgrow="ALWAYS"/>

                    </columnConstraints>


                    <!-- CANTIDAD -->

                    <VBox GridPane.columnIndex="0"
                          spacing="1">

                        <Label text="VENTAS"
                               style="-fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #718078;"/>

                        <Label fx:id="lblCantidadVentas"
                               text="0"
                               style="-fx-font-size: 19px;
                                      -fx-font-weight: bold;"/>

                    </VBox>


                    <!-- TOTAL VENDIDO -->

                    <VBox GridPane.columnIndex="1"
                          spacing="1">

                        <Label text="TOTAL VENDIDO"
                               style="-fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #718078;"/>

                        <Label fx:id="lblTotalVendido"
                               text="0"
                               style="-fx-font-size: 19px;
                                      -fx-font-weight: bold;"/>

                    </VBox>


                    <!-- PAGADO -->

                    <VBox GridPane.columnIndex="2"
                          spacing="1">

                        <Label text="PAGADO AL VENDER"
                               style="-fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #718078;"/>

                        <Label fx:id="lblTotalPagado"
                               text="0"
                               style="-fx-font-size: 19px;
                                      -fx-font-weight: bold;"/>

                    </VBox>

                </GridPane>


                <!-- SEPARADOR VISUAL -->

                <Region prefHeight="1"
                        maxHeight="1"
                        style="-fx-background-color: #e1e6e3;"/>


                <!-- ================================================= -->
                <!-- CRÉDITO                                           -->
                <!-- ================================================= -->

                <HBox alignment="CENTER_LEFT"
                      spacing="10">

                    <Label text="Crédito"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="lblPorcentajeRecuperado"
                           text="0 %"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;"/>

                    <Label text="recuperado"
                           styleClass="campo-label"/>

                </HBox>


                <!-- DATOS DEL CRÉDITO -->

                <GridPane hgap="30"
                          vgap="2">

                    <columnConstraints>

                        <ColumnConstraints percentWidth="33.33"
                                           hgrow="ALWAYS"/>

                        <ColumnConstraints percentWidth="33.33"
                                           hgrow="ALWAYS"/>

                        <ColumnConstraints percentWidth="33.34"
                                           hgrow="ALWAYS"/>

                    </columnConstraints>


                    <!-- GENERADO -->

                    <VBox GridPane.columnIndex="0"
                          spacing="1">

                        <Label text="GENERADO"
                               style="-fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #718078;"/>

                        <Label fx:id="lblTotalPendiente"
                               text="0"
                               style="-fx-font-size: 17px;
                                      -fx-font-weight: bold;"/>

                    </VBox>


                    <!-- RECUPERADO -->

                    <VBox GridPane.columnIndex="1"
                          spacing="1">

                        <Label text="RECUPERADO"
                               style="-fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #718078;"/>

                        <Label fx:id="lblCreditoRecuperado"
                               text="0"
                               style="-fx-font-size: 17px;
                                      -fx-font-weight: bold;"/>

                    </VBox>


                    <!-- PENDIENTE -->

                    <VBox GridPane.columnIndex="2"
                          spacing="1">

                        <Label text="PENDIENTE"
                               style="-fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #718078;"/>

                        <Label fx:id="lblCreditoPendiente"
                               text="0"
                               style="-fx-font-size: 17px;
                                      -fx-font-weight: bold;"/>

                    </VBox>

                </GridPane>


                <!-- PROGRESO -->

                <HBox alignment="CENTER_LEFT"
                      spacing="10">

                    <Label text="Recuperación"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #718078;"/>

                    <ProgressBar fx:id="barraRecuperacion"
                                   progress="0"
                                   prefHeight="14"
                                   minHeight="14"
                                   maxHeight="14"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="barra-recuperacion"/>

                </HBox>

            </VBox>


            <!-- MARGEN FINAL -->

            <Region prefHeight="8"/>

        </VBox>

    </content>

</ScrollPane>