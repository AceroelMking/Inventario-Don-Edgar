<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.reporte.ReporteInventarioControlador"
      stylesheets="@../css/estilos.css"
      styleClass="modulo-contenido"
      spacing="10">

    <padding>
        <Insets top="14"
                right="18"
                bottom="14"
                left="18"/>
    </padding>


    <!-- ENCABEZADO -->

    <HBox alignment="CENTER_LEFT"
          spacing="10">

        <VBox spacing="1">

            <Label text="Reportes"
                   styleClass="titulo-pagina"/>

            <Label text="Consulta y analiza la información registrada en el sistema."
                   styleClass="subtitulo-pagina"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Actualizar"
                onAction="#actualizar"
                styleClass="boton-secundario"/>

        <Button text="Exportar PDF"
                onAction="#exportarPdf"
                styleClass="boton-primario"/>

    </HBox>


    <!-- NAVEGACIÓN -->

    <HBox alignment="CENTER_LEFT"
          spacing="8"
          styleClass="tarjeta-filtros">

        <Button text="Ventas"
                onAction="#abrirVentas"
                styleClass="boton-secundario"/>

        <Button text="Inventario"
                disable="true"
                styleClass="boton-primario"/>

        <Button text="Cuentas por cobrar"
                onAction="#abrirCuentasCobrar"
                styleClass="boton-secundario"/>

    </HBox>


    <!-- BÚSQUEDA -->

    <VBox spacing="6"
          styleClass="tarjeta-filtros">

        <HBox alignment="CENTER_LEFT"
              spacing="12">

            <VBox spacing="2">

                <Label text="Inventario"
                       styleClass="filtro-titulo"/>

                <Label text="Busca productos por código, nombre, marca o categoría."
                       styleClass="filtro-descripcion"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtBuscar"
                       promptText="Buscar producto..."
                       prefWidth="360"/>

            <Button text="Limpiar"
                    onAction="#limpiarBusqueda"
                    styleClass="boton-secundario"/>

        </HBox>

    </VBox>


    <!-- TABLA -->

    <VBox spacing="5"
          styleClass="tarjeta-tabla"
          VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT">

            <VBox spacing="1">

                <Label text="Productos registrados"
                       styleClass="tabla-titulo"/>

                <Label text="Estado actual de las existencias del inventario."
                       styleClass="tabla-descripcion"/>

            </VBox>

        </HBox>


        <TableView fx:id="tablaInventario"
                   VBox.vgrow="ALWAYS"
                   minHeight="300">

            <columns>

                <TableColumn fx:id="columnaCodigo"
                             text="Código"
                             prefWidth="140"/>

                <TableColumn fx:id="columnaNombre"
                             text="Producto"
                             prefWidth="210"/>

                <TableColumn fx:id="columnaMarca"
                             text="Marca"
                             prefWidth="150"/>

                <TableColumn fx:id="columnaCategoria"
                             text="Categoría"
                             prefWidth="160"/>

                <TableColumn fx:id="columnaExistencias"
                             text="Existencias"
                             prefWidth="110"/>

                <TableColumn fx:id="columnaMinimo"
                             text="Mínimo"
                             prefWidth="100"/>

                <TableColumn fx:id="columnaUnidad"
                             text="Unidad"
                             prefWidth="120"/>

                <TableColumn fx:id="columnaEstado"
                             text="Estado"
                             prefWidth="150"/>

            </columns>

            <placeholder>

                <VBox alignment="CENTER"
                      spacing="4">

                    <Label text="No hay productos para mostrar"
                           styleClass="tabla-vacia-titulo"/>

                    <Label text="Registra productos o modifica la búsqueda."
                           styleClass="tabla-vacia-texto"/>

                </VBox>

            </placeholder>

        </TableView>

    </VBox>


    <!-- RESUMEN COMPACTO -->

    <HBox alignment="CENTER_LEFT"
          spacing="0"
          styleClass="tarjeta-filtros">

        <!-- PRODUCTOS MOSTRADOS -->

        <VBox spacing="2"
              HBox.hgrow="ALWAYS"
              maxWidth="Infinity">

            <Label text="Productos mostrados"
                   styleClass="campo-label"/>

            <Label fx:id="lblCantidadProductos"
                   text="0"
                   styleClass="total-venta"/>

        </VBox>


        <!-- STOCK BAJO -->

        <VBox spacing="2"
              HBox.hgrow="ALWAYS"
              maxWidth="Infinity">

            <Label text="Stock bajo"
                   styleClass="campo-label"/>

            <Label fx:id="lblStockBajo"
                   text="0"
                   styleClass="saldo-venta"/>

        </VBox>


        <!-- SIN EXISTENCIAS -->

        <VBox spacing="2"
              HBox.hgrow="ALWAYS"
              maxWidth="Infinity">

            <Label text="Sin existencias"
                   styleClass="campo-label"/>

            <Label fx:id="lblSinExistencias"
                   text="0"
                   styleClass="saldo-venta"/>

        </VBox>

    </HBox>

</VBox>