<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.reporte.ReporteInventarioControlador"
      spacing="15">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <!-- ENCABEZADO -->

    <HBox alignment="CENTER_LEFT"
          spacing="10">

        <VBox spacing="5">

            <Label text="Reportes"/>

            <Label text="Consulta y exportación de información"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Actualizar"
                onAction="#actualizar"/>

        <Button text="Exportar PDF"
                onAction="#exportarPdf"/>

    </HBox>

    <!-- NAVEGACIÓN ENTRE REPORTES -->

    <HBox alignment="CENTER_LEFT"
          spacing="10">

        <Label text="Tipo de reporte:"/>

        <Button text="Ventas"
                onAction="#abrirVentas"/>

        <Button text="Inventario"
                disable="true"/>

    </HBox>

    <!-- FILTROS -->

    <HBox alignment="CENTER_LEFT"
          spacing="10">

        <Label text="Buscar"/>

        <TextField fx:id="txtBuscar"
                   promptText="Código, producto, marca o categoría"
                   prefWidth="350"/>

        <Button text="Limpiar"
                onAction="#limpiarBusqueda"/>

    </HBox>

    <!-- TABLA -->

    <TableView fx:id="tablaInventario"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="columnaCodigo"
                         text="Código"
                         prefWidth="130"/>

            <TableColumn fx:id="columnaNombre"
                         text="Producto"
                         prefWidth="180"/>

            <TableColumn fx:id="columnaMarca"
                         text="Marca"
                         prefWidth="130"/>

            <TableColumn fx:id="columnaCategoria"
                         text="Categoría"
                         prefWidth="140"/>

            <TableColumn fx:id="columnaExistencias"
                         text="Existencias"
                         prefWidth="100"/>

            <TableColumn fx:id="columnaMinimo"
                         text="Mínimo"
                         prefWidth="90"/>

            <TableColumn fx:id="columnaUnidad"
                         text="Unidad"
                         prefWidth="100"/>

            <TableColumn fx:id="columnaEstado"
                         text="Estado"
                         prefWidth="130"/>

        </columns>

        <placeholder>
            <Label text="No hay productos registrados"/>
        </placeholder>

    </TableView>

    <!-- RESUMEN -->

    <HBox alignment="CENTER_LEFT"
          spacing="40">

        <VBox spacing="5">

            <Label text="Productos mostrados"/>

            <Label fx:id="lblCantidadProductos"
                   text="0"/>

        </VBox>

        <VBox spacing="5">

            <Label text="Productos con stock bajo"/>

            <Label fx:id="lblStockBajo"
                   text="0"/>

        </VBox>

        <VBox spacing="5">

            <Label text="Productos sin existencias"/>

            <Label fx:id="lblSinExistencias"
                   text="0"/>

        </VBox>

    </HBox>

</VBox>