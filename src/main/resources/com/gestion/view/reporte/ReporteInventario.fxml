<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.reporte.ReporteInventarioControlador"
      stylesheets="@../css/estilos.css"
      styleClass="modulo-contenido"
      spacing="10">

    <padding>
        <Insets top="14"
                right="18"
                bottom="16"
                left="18"/>
    </padding>


    <!-- ENCABEZADO -->

    <HBox alignment="CENTER_LEFT"
          spacing="10">

        <VBox spacing="1">

            <Label text="Reportes"
                   styleClass="titulo-pagina"/>

            <Label text="Consulta y analiza la información registrada en el sistema."
                   styleClass="subtitulo-pagina"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Actualizar"
                onAction="#actualizar"
                styleClass="boton-secundario"/>

        <Button text="Exportar PDF"
                onAction="#exportarPdf"
                styleClass="boton-primario"/>

    </HBox>


    <!-- NAVEGACIÓN -->

    <HBox alignment="CENTER_LEFT"
          spacing="8"
          styleClass="tarjeta-filtros">

        <Button text="Ventas"
                onAction="#abrirVentas"
                styleClass="boton-secundario"/>

        <Button text="Inventario"
                disable="true"
                styleClass="boton-primario"/>

        <Button text="Cuentas por cobrar"
                onAction="#abrirCuentasCobrar"
                styleClass="boton-secundario"/>

    </HBox>


    <!-- BÚSQUEDA -->

    <VBox spacing="6"
          styleClass="tarjeta-filtros">

        <HBox alignment="CENTER_LEFT"
              spacing="15">

            <VBox spacing="1">

                <Label text="Inventario"
                       styleClass="filtro-titulo"/>

                <Label text="Busca productos por código, nombre, marca o categoría."
                       styleClass="filtro-descripcion"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtBuscar"
                       promptText="Buscar producto..."
                       prefWidth="400"/>

            <Button text="Limpiar"
                    onAction="#limpiarBusqueda"
                    styleClass="boton-secundario"/>

        </HBox>

    </VBox>


    <!-- TABLA -->

    <VBox spacing="5"
          styleClass="tarjeta-tabla"
          VBox.vgrow="ALWAYS">

        <VBox spacing="1">

            <Label text="Productos registrados"
                   styleClass="tabla-titulo"/>

            <Label text="Estado actual de las existencias del inventario."
                   styleClass="tabla-descripcion"/>

        </VBox>


        <TableView fx:id="tablaInventario"
                   VBox.vgrow="ALWAYS"
                   minHeight="300">

            <columns>

                <TableColumn fx:id="columnaCodigo"
                             text="Código"
                             prefWidth="130"/>

                <TableColumn fx:id="columnaNombre"
                             text="Producto"
                             prefWidth="210"/>

                <TableColumn fx:id="columnaMarca"
                             text="Marca"
                             prefWidth="150"/>

                <TableColumn fx:id="columnaCategoria"
                             text="Categoría"
                             prefWidth="160"/>

                <TableColumn fx:id="columnaExistencias"
                             text="Existencias"
                             prefWidth="120"/>

                <TableColumn fx:id="columnaMinimo"
                             text="Mínimo"
                             prefWidth="90"/>

                <TableColumn fx:id="columnaUnidad"
                             text="Unidad"
                             prefWidth="125"/>

                <TableColumn fx:id="columnaEstado"
                             text="Estado"
                             prefWidth="180"/>

            </columns>


            <placeholder>

                <VBox alignment="CENTER"
                      spacing="4">

                    <Label text="No hay productos para mostrar"
                           styleClass="tabla-vacia-titulo"/>

                    <Label text="Registra productos o modifica la búsqueda."
                           styleClass="tabla-vacia-texto"/>

                </VBox>

            </placeholder>

        </TableView>

    </VBox>


    <!-- RESUMEN -->

    <VBox spacing="8"
          styleClass="tarjeta-filtros resumen-inventario">

        <GridPane hgap="40">

            <columnConstraints>

                <ColumnConstraints percentWidth="33.33"
                                   hgrow="ALWAYS"/>

                <ColumnConstraints percentWidth="33.33"
                                   hgrow="ALWAYS"/>

                <ColumnConstraints percentWidth="33.34"
                                   hgrow="ALWAYS"/>

            </columnConstraints>


            <!-- PRODUCTOS -->

            <VBox GridPane.columnIndex="0"
                  spacing="2">

                <Label text="PRODUCTOS MOSTRADOS"
                       style="-fx-font-size: 10px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #718078;"/>

                <Label fx:id="lblCantidadProductos"
                       text="0"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2f6b43;"/>

            </VBox>


            <!-- STOCK BAJO -->

            <VBox GridPane.columnIndex="1"
                  spacing="2">

                <Label text="STOCK BAJO"
                       style="-fx-font-size: 10px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #718078;"/>

                <Label fx:id="lblStockBajo"
                       text="0"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #a05a17;"/>

            </VBox>


            <!-- SIN EXISTENCIAS -->

            <VBox GridPane.columnIndex="2"
                  spacing="2">

                <Label text="SIN EXISTENCIAS"
                       style="-fx-font-size: 10px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #718078;"/>

                <Label fx:id="lblSinExistencias"
                       text="0"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #a05a17;"/>

            </VBox>

        </GridPane>

    </VBox>

</VBox>