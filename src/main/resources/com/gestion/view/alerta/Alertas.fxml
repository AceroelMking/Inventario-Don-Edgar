<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.alerta.AlertaControlador"
      stylesheets="@../css/estilos.css"
      styleClass="modulo-contenido"
      spacing="10">

    <padding>
        <Insets top="14"
                right="18"
                bottom="16"
                left="18"/>
    </padding>


    <!-- ENCABEZADO -->

    <HBox alignment="CENTER_LEFT"
          spacing="10">

        <VBox spacing="1">

            <Label text="Alertas"
                   styleClass="titulo-pagina"/>

            <Label text="Consulta productos con stock bajo y registros de lotes próximos a vencer."
                   styleClass="subtitulo-pagina"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Actualizar"
                onAction="#actualizar"
                styleClass="boton-primario"/>

    </HBox>


    <!-- FILTROS -->

    <VBox spacing="8"
          styleClass="tarjeta-filtros">

        <VBox spacing="1">

            <Label text="Consulta de alertas"
                   styleClass="filtro-titulo"/>

            <Label text="Busca un producto o filtra las alertas según su tipo."
                   styleClass="filtro-descripcion"/>

        </VBox>

        <HBox alignment="CENTER_LEFT"
              spacing="10">

            <TextField fx:id="txtBuscar"
                       promptText="Producto, código de barras, lote o estado..."
                       prefWidth="420"
                       HBox.hgrow="ALWAYS"/>

            <ComboBox fx:id="cmbTipo"
                      prefWidth="190"/>

            <Button text="Limpiar"
                    onAction="#limpiarFiltros"
                    styleClass="boton-secundario"/>

        </HBox>

    </VBox>


    <!-- TABLA -->

    <VBox spacing="5"
          styleClass="tarjeta-tabla"
          VBox.vgrow="ALWAYS">

        <VBox spacing="1">

            <Label text="Alertas detectadas"
                   styleClass="tabla-titulo"/>

            <Label text="Las alertas se calculan automáticamente con la información actual del sistema."
                   styleClass="tabla-descripcion"/>

        </VBox>


        <TableView fx:id="tablaAlertas"
                   VBox.vgrow="ALWAYS"
                   minHeight="300">

            <columns>

                <TableColumn fx:id="columnaTipo"
                             text="Tipo"
                             prefWidth="100"/>

                <TableColumn fx:id="columnaProducto"
                             text="Producto"
                             prefWidth="190"/>

                <TableColumn fx:id="columnaCodigo"
                             text="Código"
                             prefWidth="140"/>

                <TableColumn fx:id="columnaLote"
                             text="Lote"
                             prefWidth="120"/>

                <TableColumn fx:id="columnaVencimiento"
                             text="Vencimiento"
                             prefWidth="140"/>

                <TableColumn fx:id="columnaDetalle"
                             text="Detalle"
                             prefWidth="280"/>

                <TableColumn fx:id="columnaEstado"
                             text="Estado"
                             prefWidth="160"/>

            </columns>


            <placeholder>

                <VBox alignment="CENTER"
                      spacing="4">

                    <Label text="No hay alertas"
                           styleClass="tabla-vacia-titulo"/>

                    <Label text="No se encontraron alertas con los filtros seleccionados."
                           styleClass="tabla-vacia-texto"/>

                </VBox>

            </placeholder>

        </TableView>

    </VBox>


    <!-- RESUMEN -->

    <VBox spacing="8"
          styleClass="tarjeta-filtros resumen-alertas">

        <GridPane hgap="30">

            <columnConstraints>

                <ColumnConstraints percentWidth="25"
                                   hgrow="ALWAYS"/>

                <ColumnConstraints percentWidth="25"
                                   hgrow="ALWAYS"/>

                <ColumnConstraints percentWidth="25"
                                   hgrow="ALWAYS"/>

                <ColumnConstraints percentWidth="25"
                                   hgrow="ALWAYS"/>

            </columnConstraints>


            <VBox GridPane.columnIndex="0"
                  spacing="2">

                <Label text="TOTAL"
                       styleClass="alerta-resumen-titulo"/>

                <Label fx:id="lblTotalAlertas"
                       text="0"
                       styleClass="alerta-resumen-total"/>

            </VBox>


            <VBox GridPane.columnIndex="1"
                  spacing="2">

                <Label text="STOCK"
                       styleClass="alerta-resumen-titulo"/>

                <Label fx:id="lblStock"
                       text="0"
                       styleClass="alerta-resumen-advertencia"/>

            </VBox>


            <VBox GridPane.columnIndex="2"
                  spacing="2">

                <Label text="PRÓXIMOS A VENCER"
                       styleClass="alerta-resumen-titulo"/>

                <Label fx:id="lblProximosVencer"
                       text="0"
                       styleClass="alerta-resumen-advertencia"/>

            </VBox>


            <VBox GridPane.columnIndex="3"
                  spacing="2">

                <Label text="VENCIDOS"
                       styleClass="alerta-resumen-titulo"/>

                <Label fx:id="lblVencidos"
                       text="0"
                       styleClass="alerta-resumen-peligro"/>

            </VBox>

        </GridPane>

    </VBox>

</VBox>