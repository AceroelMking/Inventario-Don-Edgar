<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gestion.controller.AccesoControlador"
           fx:id="panelAcceso"
           prefWidth="1100"
           prefHeight="700"
           minWidth="900"
           minHeight="650"
           stylesheets="@css/estilos.css">

    <ImageView fx:id="imagenFondo"
               preserveRatio="false"
               smooth="true"
               mouseTransparent="true">

        <image>
            <Image url="@Images/fondo-login.png"/>
        </image>

    </ImageView>

    <VBox alignment="CENTER"
          spacing="12"
          prefWidth="430"
          maxWidth="430"
          prefHeight="620"
          maxHeight="620"
          styleClass="login-panel-moderno">

        <padding>
            <Insets top="24"
                    right="42"
                    bottom="24"
                    left="42"/>
        </padding>

        <ImageView fitWidth="175"
                   fitHeight="175"
                   preserveRatio="true"
                   smooth="true"
                   mouseTransparent="true">

            <image>
                <Image url="@Images/logo-don-edgar.png"/>
            </image>

        </ImageView>

        <Region prefWidth="75"
                maxWidth="75"
                prefHeight="3"
                maxHeight="3"
                styleClass="login-separador"/>

        <VBox alignment="CENTER"
              spacing="4">

            <Label text="Iniciar sesión"
                   styleClass="login-titulo-sesion"/>

            <Label text="Ingrese sus credenciales para acceder al sistema"
                   styleClass="login-descripcion"/>

        </VBox>

        <Region prefHeight="3"/>

        <VBox spacing="7"
              maxWidth="340">

            <Label text="Usuario"
                   styleClass="login-label"/>

            <TextField fx:id="txtUsuario"
                       promptText="Ingrese su usuario"
                       prefHeight="46"
                       maxWidth="340"
                       styleClass="login-campo"/>

        </VBox>

        <VBox spacing="7"
              maxWidth="340">

            <Label text="Contraseña"
                   styleClass="login-label"/>

            <PasswordField fx:id="txtContrasena"
                           promptText="Ingrese su contraseña"
                           prefHeight="46"
                           maxWidth="340"
                           styleClass="login-campo"
                           onAction="#iniciarSesion"/>

        </VBox>

        <Label fx:id="lblMensaje"
               text=""
               wrapText="true"
               alignment="CENTER"
               maxWidth="340"
               styleClass="login-error"/>

        <Button text="Ingresar"
                onAction="#iniciarSesion"
                defaultButton="true"
                prefWidth="340"
                prefHeight="46"
                styleClass="login-boton"/>

        <Region prefWidth="340"
                maxWidth="340"
                prefHeight="1"
                maxHeight="1"
                styleClass="login-linea"/>

        <Label text="Acceso exclusivo para el administrador"
               styleClass="login-acceso"/>

    </VBox>

</StackPane>
