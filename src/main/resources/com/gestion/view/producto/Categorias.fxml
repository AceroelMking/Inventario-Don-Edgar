<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestion.controller.categoria.CategoriaControlador">
   <children>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Label text="Lista de catgorias" textAlignment="CENTER" />
            <Button fx:id="botonAgregar" mnemonicParsing="false" onAction="#agregarCategoria" text="+" />
         </children>
      </HBox>
      <TableView fx:id="tablaCategorias" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="columnaId" text="#" />
          <TableColumn fx:id="columnaCategoria" text="Categoria" />
            <TableColumn fx:id="columnaEditar" text="Editar" />
        </columns>
      </TableView>
      <Button fx:id="botonSalir" mnemonicParsing="false" onAction="#salir" text="Salir" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
