<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.producto.ProductoControlador">

    <padding>
        <Insets top="30"
                right="35"
                bottom="30"
                left="35"/>
    </padding>

    <!-- ENCABEZADO -->
    <HBox alignment="CENTER_LEFT"
          spacing="15">

        <Button text="Categorías de productos"
                onAction="#abrirCategorias"
                styleClass="boton-secundario"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Productos"
               styleClass="titulo-pagina"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Actualizar"
                onAction="#actualizarProductos"
                styleClass="boton-secundario"/>

        <Button text="Agregar producto"
                onAction="#abrirFormularioAgregar"
                styleClass="boton-principal"/>

    </HBox>


    <!-- FILTROS -->
    <HBox spacing="15"
          alignment="CENTER_LEFT">

        <ComboBox fx:id="filtroCodigoBarras"
                  promptText="Código de barras"
                  editable="true"
                  prefWidth="230"/>

        <ComboBox fx:id="filtroNombre"
                  promptText="Nombre de producto"
                  editable="true"
                  prefWidth="230"/>

        <ComboBox fx:id="filtroMarca"
                  promptText="Marca/Distribuidor"
                  editable="true"
                  prefWidth="230"/>

        <ComboBox fx:id="filtroNombreCategoria"
                  promptText="Categoría"
                  editable="true"
                  prefWidth="230"/>

    </HBox>


    <!-- TABLA -->
    <VBox styleClass="tarjeta"
          VBox.vgrow="ALWAYS">

        <TableView fx:id="tablaProductos"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="columnaCodigo"
                             text="Código"
                             prefWidth="150"/>

                <TableColumn fx:id="columnaNombre"
                             text="Nombre"
                             prefWidth="150"/>

                <TableColumn fx:id="columnaMarca"
                             text="Marca/Distribuidor"
                             prefWidth="160"/>

                <TableColumn fx:id="columnaCategoria"
                             text="Categoría"
                             prefWidth="120"/>

                <TableColumn fx:id="columnaCantidad"
                             text="Cantidad"
                             prefWidth="100"/>

                <TableColumn fx:id="columnaUnidadMedida"
                             text="Unidad medida"
                             prefWidth="130"/>

                <TableColumn fx:id="columnaProductoPadre"
                             text="Unidad agrupada"
                             prefWidth="140"/>

                <TableColumn fx:id="columnaPrecio"
                             text="Precio"
                             prefWidth="110"/>

                <TableColumn fx:id="columnaExistencias"
                             text="Existencias"
                             prefWidth="110"/>

                <TableColumn fx:id="columnaMinimoExistencias"
                             text="Mín. existencias"
                             prefWidth="130"/>

                <TableColumn fx:id="columnaEditar"
                             text="Acciones"
                             prefWidth="100"/>

            </columns>

            <placeholder>
                <Label text="No hay productos registrados."/>
            </placeholder>

        </TableView>

    </VBox>

</VBox>