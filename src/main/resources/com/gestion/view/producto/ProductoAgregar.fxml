<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controller.producto.ProductoFormularioControlador"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            pannable="true"
            styleClass="formulario-scroll"
            stylesheets="@../css/estilos.css">

    <content>

        <VBox alignment="TOP_CENTER"
              spacing="12"
              styleClass="modulo-contenido">

            <padding>
                <Insets top="18"
                        right="25"
                        bottom="18"
                        left="25"/>
            </padding>

            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <HBox alignment="CENTER_LEFT"
                  maxWidth="900">

                <VBox spacing="2">

                    <Label text="Agregar producto"
                           styleClass="titulo-pagina"/>

                    <Label text="Registre la información del nuevo producto."
                           styleClass="subtitulo-pagina"/>

                </VBox>

            </HBox>

            <!-- ================================================= -->
            <!-- INFORMACIÓN GENERAL                               -->
            <!-- ================================================= -->

            <VBox spacing="12"
                  maxWidth="900"
                  styleClass="formulario-tarjeta">

                <padding>
                    <Insets top="15"
                            right="18"
                            bottom="15"
                            left="18"/>
                </padding>

                <Label text="Información general"
                       styleClass="formulario-seccion-titulo"/>

                <!-- FILA 1 -->

                <HBox spacing="15">

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Código de barras"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtCodigoBarras"
                                   promptText="Ingrese o escanee el código"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Nombre del producto"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtNombreProducto"
                                   promptText="Ej. Leche entera"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                </HBox>

                <!-- FILA 2 -->

                <HBox spacing="15">

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Marca / Distribuidor"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtMarca"
                                   promptText="Ej. Alpina"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Categoría"
                               styleClass="campo-label"/>

                        <ChoiceBox fx:id="seleccionCategoria"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                </HBox>

            </VBox>

            <!-- ================================================= -->
            <!-- PRESENTACIÓN E INVENTARIO                         -->
            <!-- ================================================= -->

            <VBox spacing="12"
                  maxWidth="900"
                  styleClass="formulario-tarjeta">

                <padding>
                    <Insets top="15"
                            right="18"
                            bottom="15"
                            left="18"/>
                </padding>

                <Label text="Presentación e inventario"
                       styleClass="formulario-seccion-titulo"/>

                <!-- CANTIDAD -->

                <VBox spacing="4">

                    <Label text="Cantidad / presentación"
                           styleClass="campo-label"/>

                    <TextField fx:id="txtCantidadProducto"
                               promptText="Ej. 500, 1, 250"
                               prefHeight="36"
                               maxWidth="Infinity"/>

                    <Label text="Indique cuánto contiene el producto. Ejemplo: 500 g, 1 L o 250 ml."
                           wrapText="true"
                           styleClass="campo-ayuda"/>

                </VBox>

                <!-- TIPO DE UNIDAD -->

                <HBox spacing="15">

                    <VBox spacing="7"
                          HBox.hgrow="ALWAYS"
                          styleClass="opcion-unidad">

                        <padding>
                            <Insets top="10"
                                    right="12"
                                    bottom="10"
                                    left="12"/>
                        </padding>

                        <RadioButton fx:id="unidadMedida"
                                     mnemonicParsing="false"
                                     selected="true"
                                     text="Unidad de medida"
                                     styleClass="radio-opcion">

                            <toggleGroup>
                                <ToggleGroup fx:id="grupoTipoUnidad"/>
                            </toggleGroup>

                        </RadioButton>

                        <ChoiceBox fx:id="seleccionUnidadMedida"
                                   prefHeight="34"
                                   maxWidth="Infinity"/>

                    </VBox>

                    <VBox spacing="7"
                          HBox.hgrow="ALWAYS"
                          styleClass="opcion-unidad">

                        <padding>
                            <Insets top="10"
                                    right="12"
                                    bottom="10"
                                    left="12"/>
                        </padding>

                        <RadioButton fx:id="unidadAgrupada"
                                     mnemonicParsing="false"
                                     text="Unidad agrupada"
                                     toggleGroup="$grupoTipoUnidad"
                                     styleClass="radio-opcion"/>

                        <ComboBox fx:id="txtUnidadAgrupada"
                                  disable="true"
                                  editable="true"
                                  promptText="Seleccione producto padre"
                                  prefHeight="34"
                                  maxWidth="Infinity"/>

                    </VBox>

                </HBox>

                <!-- PRECIO Y STOCK MÍNIMO -->

                <HBox spacing="15">

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Precio de venta"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtPrecio"
                                   promptText="Ej. 5000"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Mínimo de existencias"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtMinimoExistencias"
                                   promptText="Ej. 5"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                </HBox>

                <!-- AVISO -->

                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      styleClass="formulario-aviso">

                    <padding>
                        <Insets top="8"
                                right="12"
                                bottom="8"
                                left="12"/>
                    </padding>

                    <Label text="i"
                           styleClass="formulario-aviso-icono"/>

                    <Label text="La cantidad corresponde a la presentación del producto. Las existencias iniciales serán 0 y las entradas se registran desde Inventario / Lotes."
                           wrapText="true"
                           HBox.hgrow="ALWAYS"
                           styleClass="formulario-aviso-texto"/>

                </HBox>

            </VBox>

            <!-- ================================================= -->
            <!-- BOTONES                                           -->
            <!-- ================================================= -->

            <HBox alignment="CENTER_RIGHT"
                  spacing="10"
                  maxWidth="900">

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="botonCancelar"
                        mnemonicParsing="false"
                        onAction="#cancelar"
                        prefWidth="115"
                        prefHeight="36"
                        text="Cancelar"
                        styleClass="boton-secundario"/>

                <Button fx:id="botonAceptar"
                        mnemonicParsing="false"
                        onAction="#aceptar"
                        prefWidth="145"
                        prefHeight="36"
                        text="Guardar producto"
                        styleClass="boton-principal"/>

            </HBox>

        </VBox>

    </content>

</ScrollPane>
