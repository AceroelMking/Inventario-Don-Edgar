<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controller.venta.VentaControlador"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            pannable="true"
            styleClass="formulario-scroll"
            stylesheets="@../css/estilos.css">

    <content>

        <VBox spacing="14"
              styleClass="modulo-contenido">

            <padding>
                <Insets top="22"
                        right="25"
                        bottom="22"
                        left="25"/>
            </padding>

            <!-- ENCABEZADO -->

            <VBox spacing="3">

                <Label text="Nueva venta"
                       styleClass="titulo-pagina"/>

                <Label text="Registre los productos vendidos y la información de pago."
                       styleClass="subtitulo-pagina"/>

            </VBox>

            <!-- INFORMACIÓN DE LA VENTA -->

            <VBox spacing="12"
                  styleClass="formulario-tarjeta">

                <padding>
                    <Insets top="15"
                            right="18"
                            bottom="15"
                            left="18"/>
                </padding>

                <Label text="Información de la venta"
                       styleClass="formulario-seccion-titulo"/>

                <HBox spacing="15"
                      alignment="CENTER_LEFT">

                    <!-- CLIENTE -->

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Cliente"
                               styleClass="campo-label"/>

                        <ComboBox fx:id="comboCliente"
                                  promptText="Seleccionar cliente"
                                  prefHeight="36"
                                  maxWidth="Infinity"/>

                    </VBox>

                    <!-- MÉTODO DE PAGO -->

                    <VBox spacing="4"
                          minWidth="210">

                        <Label text="Método de pago"
                               styleClass="campo-label"/>

                        <ComboBox fx:id="comboMetodoPago"
                                  promptText="Seleccionar método"
                                  prefWidth="210"
                                  prefHeight="36"/>

                    </VBox>

                </HBox>

            </VBox>

            <!-- AGREGAR PRODUCTOS -->

            <VBox spacing="12"
                  styleClass="formulario-tarjeta">

                <padding>
                    <Insets top="15"
                            right="18"
                            bottom="15"
                            left="18"/>
                </padding>

                <!-- TÍTULO -->

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="2">

                        <Label text="Agregar producto"
                               styleClass="formulario-seccion-titulo"/>

                        <Label text="Busque el producto manualmente o utilice el lector de código de barras."
                               styleClass="formulario-seccion-descripcion"/>

                    </VBox>

                </HBox>

                <!-- CAMPOS PARA AGREGAR PRODUCTO -->

                <HBox spacing="10"
                      alignment="BOTTOM_LEFT">

                    <!-- CÓDIGO DE BARRAS -->

                    <VBox spacing="4"
                          minWidth="190">

                        <Label text="Código de barras"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtCodigoBarras"
                                   promptText="Escanear o escribir código"
                                   prefWidth="210"
                                   prefHeight="36"/>

                    </VBox>

                    <!-- PRODUCTO -->

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Producto"
                               styleClass="campo-label"/>

                        <ComboBox fx:id="comboProducto"
                                  promptText="Seleccionar producto"
                                  prefHeight="36"
                                  maxWidth="Infinity"/>

                    </VBox>

                    <!-- CANTIDAD -->

                    <VBox spacing="4"
                          minWidth="110">

                        <Label text="Cantidad"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtCantidad"
                                   promptText="1"
                                   prefWidth="110"
                                   prefHeight="36"/>

                    </VBox>

                    <!-- BOTÓN AGREGAR -->

                    <Button text="Agregar"
                            mnemonicParsing="false"
                            onAction="#agregarProducto"
                            prefWidth="105"
                            prefHeight="36"
                            styleClass="boton-principal"/>

                </HBox>

                <!-- AVISO DEL LECTOR -->

                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      styleClass="formulario-aviso">

                    <padding>
                        <Insets top="7"
                                right="12"
                                bottom="7"
                                left="12"/>
                    </padding>

                    <Label text="i"
                           styleClass="formulario-aviso-icono"/>

                    <Label text="Al escanear un código de barras, el sistema podrá identificar el producto registrado con ese código."
                           wrapText="true"
                           HBox.hgrow="ALWAYS"
                           styleClass="formulario-aviso-texto"/>

                </HBox>

            </VBox>

            <!-- PRODUCTOS DE LA VENTA -->

            <VBox spacing="10"
                  minHeight="250"
                  prefHeight="280"
                  styleClass="tarjeta-tabla">

                <padding>
                    <Insets top="15"
                            right="15"
                            bottom="15"
                            left="15"/>
                </padding>

                <!-- ENCABEZADO DE LA TABLA -->

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="2">

                        <Label text="Productos de la venta"
                               styleClass="tabla-titulo"/>

                        <Label text="Detalle de los productos agregados a la venta actual."
                               styleClass="tabla-descripcion"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Venta actual"
                           styleClass="etiqueta-estado"/>

                </HBox>

                <!-- TABLA -->

                <TableView fx:id="tablaDetalles"
                           minHeight="185"
                           prefHeight="210"
                           fixedCellSize="42"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="columnaProducto"
                                     text="Producto"
                                     prefWidth="300"/>

                        <TableColumn fx:id="columnaCantidad"
                                     text="Cantidad"
                                     prefWidth="110"/>

                        <TableColumn fx:id="columnaPrecio"
                                     text="Precio unitario"
                                     prefWidth="155"/>

                        <TableColumn fx:id="columnaSubtotal"
                                     text="Subtotal"
                                     prefWidth="155"/>

                        <TableColumn fx:id="columnaEliminar"
                                     text="Acciones"
                                     prefWidth="125"
                                     sortable="false"/>

                    </columns>

                    <!-- MENSAJE CUANDO NO HAY PRODUCTOS -->

                    <placeholder>

                        <VBox alignment="CENTER"
                              spacing="6">

                            <Label text="Venta sin productos"
                                   styleClass="tabla-vacia-titulo"/>

                            <Label text="Agregue uno o más productos para comenzar la venta."
                                   styleClass="tabla-vacia-texto"/>

                        </VBox>

                    </placeholder>

                </TableView>

            </VBox>

            <!-- RESUMEN Y PAGO -->

            <HBox alignment="CENTER_LEFT"
                  spacing="18"
                  styleClass="formulario-tarjeta">

                <padding>
                    <Insets top="18"
                            right="18"
                            bottom="18"
                            left="18"/>
                </padding>

                <!-- TOTAL -->

                <VBox spacing="3"
                      minWidth="150">

                    <Label text="Total de la venta"
                           styleClass="campo-label"/>

                    <Label fx:id="lblTotal"
                           text="0"
                           styleClass="total-venta"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- MONTO PAGADO -->

                <VBox spacing="4"
                      minWidth="160">

                    <Label text="Monto pagado"
                           styleClass="campo-label"/>

                    <TextField fx:id="txtMontoPagado"
                               promptText="0"
                               prefWidth="160"
                               prefHeight="36"/>

                </VBox>

                <!-- SALDO PENDIENTE -->

                <VBox spacing="3"
                      minWidth="150">

                    <Label text="Saldo pendiente"
                           styleClass="campo-label"/>

                    <Label fx:id="lblSaldoPendiente"
                           text="0"
                           styleClass="saldo-venta"/>

                </VBox>

                <!-- FINALIZAR VENTA -->

                <Button text="Finalizar venta"
                        mnemonicParsing="false"
                        onAction="#finalizarVenta"
                        prefWidth="145"
                        prefHeight="40"
                        styleClass="boton-principal"/>

            </HBox>

        </VBox>

    </content>

</ScrollPane>
