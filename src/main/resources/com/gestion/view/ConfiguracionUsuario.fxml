<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.ConfiguracionUsuarioControlador"
      alignment="TOP_CENTER"
      spacing="14"
      prefWidth="700"
      prefHeight="650"
      stylesheets="@css/estilos.css">

    <padding>
        <Insets top="35"
                right="50"
                bottom="35"
                left="50"/>
    </padding>

    <Label text="Configuración de acceso"
           styleClass="titulo-principal"/>

    <Label fx:id="lblObligatorio"
           text=""
           wrapText="true"
           maxWidth="500"
           style="-fx-text-fill: #c62828; -fx-font-weight: bold;"/>

    <Region prefHeight="5"/>

    <VBox spacing="5"
          maxWidth="420">

        <Label text="Nuevo nombre de usuario"/>

        <TextField fx:id="txtNuevoUsuario"
                   promptText="Ingrese el nuevo usuario"/>

        <Label fx:id="checkUsuario"
               text="○ Mínimo 4 caracteres y caracteres permitidos"/>
    </VBox>

    <VBox spacing="5"
          maxWidth="420">

        <Label text="Contraseña actual"/>

        <PasswordField fx:id="txtContrasenaActual"
                       promptText="Ingrese la contraseña actual"/>

        <Label fx:id="checkActual"
               text="○ Contraseña actual requerida"/>
    </VBox>

    <VBox spacing="5"
          maxWidth="420">

        <Label text="Nueva contraseña"/>

        <PasswordField fx:id="txtNuevaContrasena"
                       promptText="Ingrese la nueva contraseña"/>

        <Label fx:id="checkLongitud"
               text="○ Mínimo 12 caracteres"/>

        <Label fx:id="checkMayuscula"
               text="○ Una letra mayúscula"/>

        <Label fx:id="checkMinuscula"
               text="○ Una letra minúscula"/>

        <Label fx:id="checkNumero"
               text="○ Un número"/>

        <Label fx:id="checkEspecial"
               text="○ Un carácter especial"/>
    </VBox>

    <VBox spacing="5"
          maxWidth="420">

        <Label text="Confirmar nueva contraseña"/>

        <PasswordField fx:id="txtConfirmarContrasena"
                       promptText="Repita la nueva contraseña"/>

        <Label fx:id="checkCoinciden"
               text="○ Las contraseñas deben coincidir"/>
    </VBox>

    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"
           maxWidth="420"/>

    <Button text="Guardar credenciales"
            onAction="#guardar"
            prefWidth="250"
            prefHeight="42"/>

</VBox>