<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.venta.VentaControlador">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <VBox spacing="4">
        <Label text="Nueva venta"
               styleClass="titulo-pagina"/>

        <Label text="Registra los productos vendidos y la información de pago."
               styleClass="descripcion-pagina"/>
    </VBox>

    <HBox spacing="15"
          alignment="CENTER_LEFT"
          styleClass="tarjeta">

        <VBox spacing="7"
              HBox.hgrow="ALWAYS">

            <Label text="Cliente"
                   styleClass="titulo-tarjeta"/>

            <ComboBox fx:id="comboCliente"
                      promptText="Seleccionar cliente"
                      maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="7">

            <Label text="Método de pago"
                   styleClass="titulo-tarjeta"/>

            <ComboBox fx:id="comboMetodoPago"
                      promptText="Método de pago"
                      prefWidth="180"/>
        </VBox>

    </HBox>

    <VBox spacing="12"
          styleClass="tarjeta">

        <Label text="Agregar producto"
               styleClass="titulo-tarjeta"/>

        <HBox spacing="10"
              alignment="CENTER_LEFT">

            <TextField fx:id="txtCodigoBarras"
                       promptText="Código de barras"
                       prefWidth="180"/>

            <ComboBox fx:id="comboProducto"
                      promptText="Seleccionar producto"
                      prefWidth="300"/>

            <TextField fx:id="txtCantidad"
                       promptText="Cantidad"
                       prefWidth="110"/>

            <Button text="Agregar"
                    onAction="#agregarProducto"
                    styleClass="boton-principal"/>

        </HBox>

        <Label text="Puedes seleccionar el producto o ingresar/escanear su código de barras."
               styleClass="texto-ayuda"/>

    </VBox>

    <VBox spacing="10"
          VBox.vgrow="ALWAYS"
          styleClass="tarjeta">

        <Label text="Productos de la venta"
               styleClass="titulo-tarjeta"/>

        <TableView fx:id="tablaDetalles"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="columnaProducto"
                             text="Producto"
                             prefWidth="250"/>

                <TableColumn fx:id="columnaCantidad"
                             text="Cantidad"
                             prefWidth="100"/>

                <TableColumn fx:id="columnaPrecio"
                             text="Precio unitario"
                             prefWidth="140"/>

                <TableColumn fx:id="columnaSubtotal"
                             text="Subtotal"
                             prefWidth="140"/>

                <TableColumn fx:id="columnaEliminar"
                             text="Acciones"
                             prefWidth="100"/>

            </columns>

            <placeholder>
                <Label text="Agrega productos para comenzar la venta."/>
            </placeholder>

        </TableView>

    </VBox>

    <HBox alignment="CENTER_RIGHT"
          spacing="20"
          styleClass="tarjeta">

        <VBox spacing="3">
            <Label text="Total"
                   styleClass="descripcion-pagina"/>

            <Label fx:id="lblTotal"
                   text="0"
                   styleClass="total-venta"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <VBox spacing="5">

            <Label text="Monto pagado"
                   styleClass="titulo-tarjeta"/>

            <TextField fx:id="txtMontoPagado"
                       promptText="0"
                       prefWidth="160"/>

        </VBox>

        <VBox spacing="3">

            <Label text="Saldo pendiente"
                   styleClass="descripcion-pagina"/>

            <Label fx:id="lblSaldoPendiente"
                   text="0"
                   styleClass="saldo-venta"/>

        </VBox>

        <Button text="Finalizar venta"
                onAction="#finalizarVenta"
                styleClass="boton-principal"/>

    </HBox>

</VBox>