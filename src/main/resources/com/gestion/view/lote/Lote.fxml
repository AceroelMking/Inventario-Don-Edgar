<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.lote.LoteControlador">

    <padding>
        <Insets top="30"
                right="35"
                bottom="30"
                left="35"/>
    </padding>

    <HBox alignment="CENTER_LEFT">

        <VBox spacing="4">
            <Label text="Inventario y lotes"
                   styleClass="titulo-pagina"/>

            <Label text="Registra las entradas de mercancía y consulta los movimientos de inventario."
                   styleClass="descripcion-pagina"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Registrar entrada"
                onAction="#abrirFormularioAgregar"
                styleClass="boton-principal"/>

    </HBox>

    <VBox spacing="10"
          styleClass="tarjeta"
          VBox.vgrow="ALWAYS">

        <Label text="Entradas registradas"
               styleClass="titulo-tarjeta"/>

        <TableView fx:id="tablaLotes"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="columnaProducto"
                             text="Producto"
                             prefWidth="180"/>

                <TableColumn fx:id="columnaLote"
                             text="Lote"
                             prefWidth="110"/>

                <TableColumn fx:id="columnaFechaRegistro"
                             text="Registro"
                             prefWidth="110"/>

                <TableColumn fx:id="columnaFechaVencimiento"
                             text="Vencimiento"
                             prefWidth="120"/>

                <TableColumn fx:id="columnaCantidad"
                             text="Cantidad"
                             prefWidth="100"/>

                <TableColumn fx:id="columnaValor"
                             text="Valor"
                             prefWidth="120"/>

                <TableColumn fx:id="columnaMotivo"
                             text="Motivo"
                             prefWidth="180"/>

            </columns>

            <placeholder>
                <Label text="No hay entradas de inventario registradas."/>
            </placeholder>

        </TableView>

    </VBox>

</VBox>