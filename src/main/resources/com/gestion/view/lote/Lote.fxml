<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.lote.LoteControlador"
      spacing="14"
      styleClass="modulo-contenido"
      stylesheets="@../css/estilos.css">

    <padding>
        <Insets top="22"
                right="25"
                bottom="22"
                left="25"/>
    </padding>

    <!-- ENCABEZADO -->

    <HBox alignment="CENTER_LEFT"
          spacing="15">

        <VBox spacing="3">

            <Label text="Inventario"
                   styleClass="titulo-pagina"/>

            <Label text="Consulte el historial de entradas de mercancía registradas en el sistema."
                   styleClass="subtitulo-pagina"/>

        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="+ Registrar entrada"
                mnemonicParsing="false"
                onAction="#abrirFormularioAgregar"
                styleClass="boton-principal"/>

    </HBox>

    <!-- TABLA -->

    <VBox spacing="12"
          VBox.vgrow="ALWAYS"
          styleClass="tarjeta-tabla">

        <padding>
            <Insets top="15"
                    right="15"
                    bottom="15"
                    left="15"/>
        </padding>

        <HBox alignment="CENTER_LEFT">

            <VBox spacing="2">

                <Label text="Entradas registradas"
                       styleClass="tabla-titulo"/>

                <Label text="Historial de mercancía ingresada al inventario."
                       styleClass="tabla-descripcion"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Inventario"
                   styleClass="etiqueta-estado"/>

        </HBox>

        <TableView fx:id="tablaLotes"
                   VBox.vgrow="ALWAYS">

            <placeholder>

                <VBox alignment="CENTER"
                      spacing="5">

                    <Label text="No hay entradas registradas"
                           styleClass="tabla-vacia-titulo"/>

                    <Label text="Registre una entrada para comenzar a controlar el inventario."
                           styleClass="tabla-vacia-texto"/>

                </VBox>

            </placeholder>

            <columns>

                <TableColumn fx:id="columnaProducto"
                             text="Producto"
                             prefWidth="145"/>

                <TableColumn fx:id="columnaLote"
                             text="Lote"
                             prefWidth="90"/>

                <TableColumn fx:id="columnaFechaRegistro"
                             text="Registro"
                             prefWidth="95"/>

                <!-- NUEVA COLUMNA: FECHA DE EXPEDICIÓN -->

                <TableColumn fx:id="columnaFechaExpedicion"
                             text="Expedición"
                             prefWidth="110"/>

                <TableColumn fx:id="columnaFechaVencimiento"
                             text="Vencimiento"
                             prefWidth="105"/>

                <TableColumn fx:id="columnaCantidad"
                             text="Cantidad"
                             prefWidth="80"/>

                <TableColumn fx:id="columnaValor"
                             text="Precio compra unit."
                             prefWidth="125"/>

                <TableColumn fx:id="columnaMotivo"
                             text="Motivo"
                             prefWidth="150"/>

                <TableColumn fx:id="columnaEditar"
                             text="Acciones"
                             prefWidth="90"
                             sortable="false"/>

            </columns>

        </TableView>

    </VBox>

</VBox>
