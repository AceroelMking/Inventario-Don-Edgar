<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controller.lote.LoteFormularioControlador"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            pannable="true"
            styleClass="formulario-scroll"
            stylesheets="@../css/estilos.css">

    <content>

        <VBox alignment="TOP_CENTER"
              spacing="12"
              styleClass="modulo-contenido">

            <padding>
                <Insets top="18"
                        right="25"
                        bottom="18"
                        left="25"/>
            </padding>

            <!-- ENCABEZADO -->

            <HBox alignment="CENTER_LEFT"
                  maxWidth="850">

                <VBox spacing="2">

                    <Label text="Registrar entrada"
                           styleClass="titulo-pagina"/>

                    <Label text="Registre la mercancía recibida y actualice las existencias del producto."
                           styleClass="subtitulo-pagina"/>

                </VBox>

            </HBox>

            <!-- INFORMACIÓN DE LA ENTRADA -->

            <VBox spacing="12"
                  maxWidth="850"
                  styleClass="formulario-tarjeta">

                <padding>
                    <Insets top="15"
                            right="18"
                            bottom="15"
                            left="18"/>
                </padding>

                <Label text="Información de la entrada"
                       styleClass="formulario-seccion-titulo"/>

                <Label text="Seleccione el producto e identifique el lote recibido."
                       styleClass="formulario-seccion-descripcion"/>

                <HBox spacing="15">

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Producto"
                               styleClass="campo-label"/>

                        <ComboBox fx:id="comboProducto"
                                  promptText="Seleccione un producto"
                                  prefHeight="36"
                                  maxWidth="Infinity"/>

                    </VBox>

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Código del lote"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtLote"
                                   promptText="Ej. LOT-001"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                </HBox>

            </VBox>

            <!-- FECHAS -->

            <VBox spacing="12"
                  maxWidth="850"
                  styleClass="formulario-tarjeta">

                <padding>
                    <Insets top="15"
                            right="18"
                            bottom="15"
                            left="18"/>
                </padding>

                <Label text="Fechas del lote"
                       styleClass="formulario-seccion-titulo"/>

                <Label text="Registre las fechas asociadas a la mercancía recibida."
                       styleClass="formulario-seccion-descripcion"/>

                <HBox spacing="15">

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Fecha de registro"
                               styleClass="campo-label"/>

                        <DatePicker fx:id="fechaRegistro"
                               prefHeight="36"
                               maxWidth="Infinity"
                               editable="false"
                               disable="true"/>

                    </VBox>

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Fecha de expedición"
                               styleClass="campo-label"/>

                        <DatePicker fx:id="fechaExpedicion"
                                    prefHeight="36"
                                    maxWidth="Infinity"/>

                    </VBox>

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Fecha de vencimiento"
                               styleClass="campo-label"/>

                        <DatePicker fx:id="fechaVencimiento"
                                    prefHeight="36"
                                    maxWidth="Infinity"/>

                    </VBox>

                </HBox>

            </VBox>

            <!-- MOVIMIENTO DE INVENTARIO -->

            <VBox spacing="12"
                  maxWidth="850"
                  styleClass="formulario-tarjeta">

                <padding>
                    <Insets top="15"
                            right="18"
                            bottom="15"
                            left="18"/>
                </padding>

                <Label text="Movimiento de inventario"
                       styleClass="formulario-seccion-titulo"/>

                <Label text="Indique la cantidad recibida y el precio de compra por unidad."
                       styleClass="formulario-seccion-descripcion"/>

                <HBox spacing="15">

                    <!-- CANTIDAD -->

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Cantidad recibida"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtCantidad"
                                   promptText="Ej. 20"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                    <!-- PRECIO UNITARIO -->

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Precio de compra unitario"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtValor"
                                   promptText="Ej. 3000"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                </HBox>

                <!-- MOTIVO -->

                <VBox spacing="4">

                    <Label text="Motivo"
                           styleClass="campo-label"/>

                    <TextField fx:id="txtMotivo"
                               text="Entrada de mercancía"
                               promptText="Motivo del movimiento"
                               prefHeight="36"
                               maxWidth="Infinity"/>

                </VBox>

                <!-- INFORMACIÓN -->

                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      styleClass="formulario-aviso">

                    <padding>
                        <Insets top="8"
                                right="12"
                                bottom="8"
                                left="12"/>
                    </padding>

                    <Label text="i"
                           styleClass="formulario-aviso-icono"/>

                    <Label text="Al registrar la entrada, la cantidad recibida se sumará a las existencias actuales del producto."
                           wrapText="true"
                           HBox.hgrow="ALWAYS"
                           styleClass="formulario-aviso-texto"/>

                </HBox>

            </VBox>

            <!-- BOTONES -->

            <HBox alignment="CENTER_RIGHT"
                  spacing="10"
                  maxWidth="850">

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Cancelar"
                        mnemonicParsing="false"
                        onAction="#cancelar"
                        prefWidth="115"
                        prefHeight="36"
                        styleClass="boton-secundario"/>

                <Button text="Registrar entrada"
                        mnemonicParsing="false"
                        onAction="#guardar"
                        prefWidth="155"
                        prefHeight="36"
                        styleClass="boton-principal"/>

            </HBox>

        </VBox>

    </content>

</ScrollPane>
