<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      prefWidth="520"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.lote.LoteFormularioControlador">

    <padding>
        <Insets top="25"
                right="30"
                bottom="25"
                left="30"/>
    </padding>

    <VBox spacing="4">
        <Label text="Registrar entrada"
               styleClass="titulo-pagina"/>

        <Label text="Registra mercancía recibida y actualiza las existencias del producto."
               styleClass="descripcion-pagina"/>
    </VBox>

    <VBox spacing="8">

        <Label text="Producto"
               styleClass="titulo-tarjeta"/>

        <ComboBox fx:id="comboProducto"
                  promptText="Seleccionar producto"
                  maxWidth="Infinity"/>

    </VBox>

    <VBox spacing="8">

        <Label text="Código del lote"
               styleClass="titulo-tarjeta"/>

        <TextField fx:id="txtLote"
                   promptText="Ej. LOT-001"/>

    </VBox>

    <HBox spacing="12">

        <VBox spacing="8"
              HBox.hgrow="ALWAYS">

            <Label text="Fecha de registro"/>

            <DatePicker fx:id="fechaRegistro"
                        maxWidth="Infinity"/>

        </VBox>

        <VBox spacing="8"
              HBox.hgrow="ALWAYS">

            <Label text="Fecha de expedición"/>

            <DatePicker fx:id="fechaExpedicion"
                        maxWidth="Infinity"/>

        </VBox>

    </HBox>

    <VBox spacing="8">

        <Label text="Fecha de vencimiento"/>

        <DatePicker fx:id="fechaVencimiento"
                    maxWidth="Infinity"/>

    </VBox>

    <HBox spacing="12">

        <VBox spacing="8"
              HBox.hgrow="ALWAYS">

            <Label text="Cantidad recibida"/>

            <TextField fx:id="txtCantidad"
                       promptText="Ej. 20"/>

        </VBox>

        <VBox spacing="8"
              HBox.hgrow="ALWAYS">

            <Label text="Valor de entrada"/>

            <TextField fx:id="txtValor"
                       promptText="Ej. 50000"/>

        </VBox>

    </HBox>

    <VBox spacing="8">

        <Label text="Motivo"/>

        <TextField fx:id="txtMotivo"
                   text="Entrada de mercancía"/>

    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT"
          spacing="10">

        <Button text="Cancelar"
                onAction="#cancelar"
                styleClass="boton-secundario"/>

        <Button text="Registrar entrada"
                onAction="#guardar"
                styleClass="boton-principal"/>

    </HBox>

</VBox>