<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controller.cliente.ClienteFormularioControlador"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            pannable="true"
            styleClass="formulario-scroll"
            stylesheets="@../css/estilos.css">

    <content>

        <VBox alignment="TOP_CENTER"
              spacing="12"
              styleClass="modulo-contenido">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <!-- ENCABEZADO -->

            <HBox alignment="CENTER_LEFT"
                  maxWidth="750">

                <VBox spacing="2">

                    <Label text="Nuevo cliente"
                           styleClass="titulo-pagina"/>

                    <Label text="Registre la información básica del cliente."
                           styleClass="subtitulo-pagina"/>

                </VBox>

            </HBox>

            <!-- INFORMACIÓN PERSONAL -->

            <VBox spacing="12"
                  maxWidth="750"
                  styleClass="formulario-tarjeta">

                <padding>
                    <Insets top="16"
                            right="18"
                            bottom="16"
                            left="18"/>
                </padding>

                <Label text="Información personal"
                       styleClass="formulario-seccion-titulo"/>

                <Label text="Ingrese los datos principales para identificar al cliente."
                       styleClass="formulario-seccion-descripcion"/>

                <HBox spacing="15">

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Nombre completo"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtNombre"
                                   promptText="Ej. Juan Pérez"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Número de identificación"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtIdentificacion"
                                   promptText="Ej. 1020304050"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                </HBox>

            </VBox>

            <!-- CONTACTO -->

            <VBox spacing="12"
                  maxWidth="750"
                  styleClass="formulario-tarjeta">

                <padding>
                    <Insets top="16"
                            right="18"
                            bottom="16"
                            left="18"/>
                </padding>

                <Label text="Información de contacto"
                       styleClass="formulario-seccion-titulo"/>

                <Label text="Estos datos permiten consultar y diferenciar al cliente dentro del sistema."
                       wrapText="true"
                       styleClass="formulario-seccion-descripcion"/>

                <HBox spacing="15">

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Teléfono"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtTelefono"
                                   promptText="Ej. 3001234567"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">

                        <Label text="Correo electrónico"
                               styleClass="campo-label"/>

                        <TextField fx:id="txtCorreo"
                                   promptText="Ej. cliente@correo.com"
                                   prefHeight="36"
                                   maxWidth="Infinity"/>

                    </VBox>

                </HBox>

                <!-- INFORMACIÓN -->

                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      styleClass="formulario-aviso">

                    <padding>
                        <Insets top="8"
                                right="12"
                                bottom="8"
                                left="12"/>
                    </padding>

                    <Label text="i"
                           styleClass="formulario-aviso-icono"/>

                    <Label text="El saldo del cliente inicia en cero y se actualizará automáticamente cuando se registren ventas a crédito o abonos."
                           wrapText="true"
                           HBox.hgrow="ALWAYS"
                           styleClass="formulario-aviso-texto"/>

                </HBox>

            </VBox>

            <!-- BOTONES -->

            <HBox alignment="CENTER_RIGHT"
                  spacing="10"
                  maxWidth="750">

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="botonCancelar"
                        text="Cancelar"
                        mnemonicParsing="false"
                        onAction="#cancelar"
                        prefWidth="115"
                        prefHeight="36"
                        styleClass="boton-secundario"/>

                <Button text="Guardar cliente"
                        mnemonicParsing="false"
                        onAction="#guardar"
                        prefWidth="145"
                        prefHeight="36"
                        styleClass="boton-principal"/>

            </HBox>

        </VBox>

    </content>

</ScrollPane>