<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.cliente.ClienteControlador">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <HBox alignment="CENTER_LEFT">

        <VBox spacing="4">
            <Label text="Clientes"
                   styleClass="titulo-pagina"/>

            <Label text="Administra la información de los clientes y consulta sus saldos pendientes."
                   styleClass="descripcion-pagina"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="+ Nuevo cliente"
                onAction="#abrirFormularioAgregar"
                styleClass="boton-principal"/>

    </HBox>

    <HBox alignment="CENTER_LEFT"
          spacing="10"
          styleClass="barra-herramientas">

        <TextField fx:id="txtBuscar"
                   promptText="Buscar por nombre, identificación, teléfono o correo..."
                   prefWidth="420"/>

    </HBox>

    <VBox spacing="10"
          VBox.vgrow="ALWAYS"
          styleClass="tarjeta">

        <Label text="Listado de clientes"
               styleClass="titulo-tarjeta"/>

        <TableView fx:id="tablaClientes"
           VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="columnaIdentificacion"
                             text="Identificación"/>

                <TableColumn fx:id="columnaNombre"
                             text="Nombre"/>

                <TableColumn fx:id="columnaTelefono"
                             text="Teléfono"/>

                <TableColumn fx:id="columnaCorreo"
                             text="Correo electrónico"/>

                <TableColumn fx:id="columnaSaldo"
                             text="Saldo pendiente"/>

                <TableColumn fx:id="columnaEditar"
                             text="Acciones"/>

            </columns>

            <placeholder>
                <Label text="No hay clientes registrados."/>
            </placeholder>

        </TableView>

    </VBox>

</VBox>