<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.RecuperacionContrasenaControlador"
      alignment="CENTER"
      spacing="20"
      prefWidth="650"
      prefHeight="580"
      stylesheets="@css/estilos.css"
      style="-fx-background-color: #f4f6f9;">

    <padding>
        <Insets top="30"
                right="45"
                bottom="30"
                left="45"/>
    </padding>

    <!-- ENCABEZADO -->

    <VBox alignment="CENTER"
          spacing="8">

        <Label text="Recuperación de contraseña"
               styleClass="titulo-pagina"/>

        <Label text="Recupere el acceso al sistema utilizando su clave de emergencia."
               wrapText="true"
               style="-fx-text-fill: #64748b;
                      -fx-font-size: 13px;"/>

    </VBox>

    <!-- TARJETA -->

    <VBox alignment="CENTER"
          spacing="20"
          maxWidth="510"
          style="-fx-background-color: white;
                 -fx-background-radius: 14;
                 -fx-border-color: #e2e8f0;
                 -fx-border-radius: 14;
                 -fx-padding: 28;">

        <!-- PANEL DE CLAVE DE EMERGENCIA -->

        <VBox fx:id="panelClave"
              spacing="14"
              fillWidth="true">

            <Label text="Verificar clave de emergencia"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1e293b;"/>

            <Label text="Ingrese la clave de emergencia que guardó durante la configuración de su cuenta."
                   wrapText="true"
                   style="-fx-text-fill: #64748b;
                          -fx-font-size: 12px;"/>

            <Label text="Clave de emergencia"
                   styleClass="campo-label"/>

            <TextField fx:id="txtClaveEmergencia"
                       promptText="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX"
                       prefHeight="43"
                       maxWidth="Infinity"/>

            <Label text="Puede escribir la clave con o sin guiones. No necesita conexión a internet."
                   wrapText="true"
                   style="-fx-text-fill: #64748b;
                          -fx-font-size: 11px;"/>

            <Button fx:id="btnVerificarClave"
                    text="Verificar clave"
                    onAction="#verificarClave"
                    prefHeight="43"
                    maxWidth="Infinity"
                    styleClass="boton-primario"/>

        </VBox>

        <!-- PANEL DE NUEVA CONTRASEÑA -->

        <VBox fx:id="panelNuevaContrasena"
              spacing="14"
              visible="false"
              managed="false"
              fillWidth="true">

            <Label text="Establecer nueva contraseña"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1e293b;"/>

            <Label text="La clave fue verificada. Ahora establezca una contraseña segura para recuperar el acceso."
                   wrapText="true"
                   style="-fx-text-fill: #64748b;
                          -fx-font-size: 12px;"/>

            <Label text="Nueva contraseña"
                   styleClass="campo-label"/>

            <PasswordField fx:id="txtNuevaContrasena"
                           promptText="Ingrese la nueva contraseña"
                           prefHeight="43"/>

            <Label text="Mínimo 12 caracteres, incluyendo mayúsculas, minúsculas, números y caracteres especiales."
                   wrapText="true"
                   style="-fx-text-fill: #64748b;
                          -fx-font-size: 11px;"/>

            <Label text="Confirmar contraseña"
                   styleClass="campo-label"/>

            <PasswordField fx:id="txtConfirmarContrasena"
                           promptText="Repita la nueva contraseña"
                           prefHeight="43"/>

            <Button fx:id="btnCambiarContrasena"
                    text="Restablecer contraseña"
                    onAction="#cambiarContrasena"
                    prefHeight="43"
                    maxWidth="Infinity"
                    styleClass="boton-primario"/>

        </VBox>

        <!-- MENSAJE -->

        <Label fx:id="lblMensaje"
               text=""
               wrapText="true"
               maxWidth="Infinity"/>

        <!-- SEPARADOR -->

        <Region prefHeight="1"
                maxHeight="1"
                style="-fx-background-color: #e2e8f0;"/>

        <!-- REGRESAR -->

        <HBox alignment="CENTER">

            <Button text="Volver al inicio de sesión"
                    onAction="#regresarAcceso"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #2563eb;
                           -fx-font-size: 12px;
                           -fx-cursor: hand;"/>

        </HBox>

    </VBox>

    <!-- PIE DE PÁGINA -->

    <Label text="Inventario Don Edgar | Recuperación local y segura"
           style="-fx-text-fill: #94a3b8;
                  -fx-font-size: 11px;"/>

</VBox>
